SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam — https://steamcommunity.com/dev/apikey (profile game details must be public)
STEAM_API_KEY=
STEAM_ID=
